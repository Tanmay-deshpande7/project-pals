{
  "name": "projectpals-monorepo",
  "version": "1.0.0",
  "description": "Project Pals Workspace Monorepo",
  "scripts": {
    "build:normal:js": "babel normal/js --out-dir normal/dist/js",
    "build:normal:css": "tailwindcss -i normal/style.css -o normal/dist/style.css --minify",
    "build:normal": "npm run build:normal:js && npm run build:normal:css",
    "build:admin:js": "babel admin/js --out-dir admin/dist/js",
    "build:admin:css": "tailwindcss -i admin/style.css -o admin/dist/style.css --minify",
    "build:admin": "npm run build:admin:js && npm run build:admin:css",
    "build:events:js": "babel events/js --out-dir events/dist/js",
    "build:events:css": "tailwindcss -i events/style.css -o events/dist/style.css --minify",
    "build:events": "npm run build:events:js && npm run build:events:css",
    "build": "npm run build:normal && npm run build:admin && npm run build:events"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "tailwindcss": "^3.4.1"
  }
}
